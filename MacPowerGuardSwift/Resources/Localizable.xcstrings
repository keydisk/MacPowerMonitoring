    "정격 대비 전압 강하율이 %.2f%%로 위험 기준(7%%)을 초과했습니다. 케이블/충전기 과열 위험이 있습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spannungsabfall beträgt %.2f%% und überschreitet den Grenzwert (7%%). Kabel/Netzteil können überhitzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltage drop is %.2f%%, above the danger threshold (7%%). The cable or charger may overheat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caída de tensión es del %.2f%%, por encima del umbral de peligro (7%%). El cable o cargador podría sobrecalentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chute de tension est de %.2f %%, au-delà du seuil de danger (7 %%). Risque de surchauffe du câble/chargeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定格比の電圧降下率が%.2f%%で、危険基準（7%%）を超えました。ケーブル/充電器が過熱するおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정격 대비 전압 강하율이 %.2f%%로 위험 기준(7%%)을 초과했습니다. 케이블/충전기 과열 위험이 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对额定值的压降率为 %.2f%%，超过危险阈值（7%%）。线缆/充电器有过热风险。"
          }
        }
      }
    },
    "정격 대비 전압 강하율이 %.2f%%입니다. 접촉 저항이나 케이블 품질을 확인하세요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spannungsabfall beträgt %.2f%%. Prüfen Sie Kontakt und Kabelqualität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltage drop is %.2f%%. Check contact resistance or cable quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caída de tensión es del %.2f%%. Revise el contacto o la calidad del cable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chute de tension est de %.2f %%. Vérifiez le contact et la qualité du câble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定格比の電圧降下率が%.2f%%です。接触抵抗やケーブルの品質を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정격 대비 전압 강하율이 %.2f%%입니다. 접촉 저항이나 케이블 품질을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对额定值的压降率为 %.2f%%。请检查接触电阻或线缆质量。"
