    "현재 소비 전력이 어댑터 정격의 %.1f%%입니다. 충전기 발열이 심해질 수 있습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leistungsaufnahme liegt bei %.1f%% der Netzteil-Nennleistung. Das Netzteil kann heiß werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power draw is %.1f%% of the adapter rating. The charger may run hot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El consumo es el %.1f%% de la potencia del adaptador. El cargador puede calentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consommation atteint %.1f %% de la puissance de l’adaptateur. Le chargeur peut chauffer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の消費電力がアダプタ定格の%.1f%%です。充電器が高温になるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 소비 전력이 어댑터 정격의 %.1f%%입니다. 충전기 발열이 심해질 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前功耗为适配器额定值的 %.1f%%。充电器可能严重发热。"
          }
        }
      }
    },
